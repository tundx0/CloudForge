{
  "name": "cloudforge",
  "version": "0.1.0",
  "private": true,
  "description": "CloudForge \u2014 a Node/TypeScript deploy platform that clones a git repo and builds a Docker image",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/index.ts",
    "typecheck": "tsc",
    "test": "tsx --test --disable-warning=ExperimentalWarning 'src/**/*.test.ts'",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.3",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
